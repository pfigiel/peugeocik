# Frontend env (Vercel: set these as Project Environment Variables).
# Copy to web/.env.local for local dev.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
# Edge function base (usually the URL above + /functions/v1/api)
VITE_API_BASE=https://<ref>.supabase.co/functions/v1/api
